{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/leetcode",
      "destination": "/api/leetcode"
    },
    {
      "source": "/api/codolio",
      "destination": "/api/codolio"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
